# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Only used by the import script on your computer. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Seed pipeline: a contact e-mail sent with requests, as data providers (OpenStreetMap) require.
SEED_CONTACT_EMAIL=
# Optional: use a different Overpass API server.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
